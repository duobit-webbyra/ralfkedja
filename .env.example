# PayloadCMS Secret - Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Email Configuration (nodemailer)
EMAIL_USER=
EMAIL_PASS=

# Cloudflare Turnstile
# Site key for client-side (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# Secret key for server-side validation
# In production: wrangler secret put CLOUDFLARE_TURNSTILE_SECRET_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Resend API Key for email sending
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Custom media URL for R2 storage
# NEXT_PUBLIC_MEDIA_URL=